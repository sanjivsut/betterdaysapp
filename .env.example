# ---------------------------------------------------------------------------
# Better Days — environment variables
# Copy to .env.local and fill in real values. .env.local is git-ignored.
# ---------------------------------------------------------------------------

# Postgres connection string.
# In production this is provided automatically by Netlify Database as
# NETLIFY_DATABASE_URL. Locally, paste a Neon / Postgres pooled connection
# string here. The app reads DATABASE_URL first, then NETLIFY_DATABASE_URL.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js (NextAuth v5)
# Generate with: openssl rand -base64 33
AUTH_SECRET="replace-me-with-a-random-string"
# Base URL of the app. Netlify sets URL / DEPLOY_URL automatically in prod.
AUTH_URL="http://localhost:3000"
# Trust the host header (needed on Netlify preview/prod).
AUTH_TRUST_HOST="true"

# Google OAuth — create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-oauth-client-id"
AUTH_GOOGLE_SECRET="your-google-oauth-client-secret"

# Public site URL used for SEO canonical tags, sitemap, and OpenGraph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Not wired up yet (future) ---
# OneSignal (push notification scheduling/delivery). The notification trigger
# is stubbed for now; these are placeholders for when it is integrated.
ONESIGNAL_APP_ID=""
ONESIGNAL_API_KEY=""

# VAPID keys for Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:hello@betterdays.app"
